{
  "name": "dsh-db-manager",
  "description": "DeepSeek Harness dual-face plugin: MySQL / PostgreSQL / SQLite connection registry with a settings-page management GUI, health tests, shadow backups, and safe AI query tools",
  "version": "0.22.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suoweiyou/dsh-db-manager.git"
  },
  "homepage": "https://github.com/suoweiyou/dsh-db-manager#readme",
  "bugs": {
    "url": "https://github.com/suoweiyou/dsh-db-manager/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": "^0.2.1-alpha.2"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-alpha.2": "compatible",
        "0.2.1-rc.2": "compatible"
      }
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "mysql",
    "postgresql",
    "sqlite",
    "database",
    "db-manager"
  ],
  "bin": {
    "db-manager-encrypt": "bin/encrypt.js"
  },
  "files": [
    "lib",
    "bin",
    "README.md",
    "THIRD-PARTY-NOTICES.md",
    "docs/img",
    "cordis.patch.yml",
    "cordis.patch.example.yml"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "tsup && tsc --noEmit && vitest run"
  },
  "dependencies": {
    "mysql2": "^3.14.0",
    "node-sql-parser": "^5.0.0",
    "pg": "^8.13.1",
    "ssh2": "^1.17.0",
    "zod": "^4.5.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1 || ^4.0.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-tools": "^0.2.1-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.1 || ^3.18.5-alpha.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-client-ui-settings": { "optional": true },
    "@deepseek-ai/dsh-host-webserver": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true },
    "react": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-tools": "^0.2.1-alpha.2",
    "@deepseek-ai/schemastery": "~3.18.5-alpha.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/ssh2": "^1.15.6",
    "react": "^18.2.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22.3.0"
  },
  "license": "MIT"
}
